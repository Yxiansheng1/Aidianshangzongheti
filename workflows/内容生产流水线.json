    {
      "parameters": {
        "jsCode": "const raw = $input.first().json;\nconst content = raw.choices?.[0]?.message?.content ?? '';\nlet data;\ntry {\n  const m = content.match(/```(?:json)?\\s*([\\s\\S]*?)```/);\n  data = JSON.parse(m ? m[1] : content);\n} catch (e) {\n  data = { passed: false, score: 0, issues: [{ level: 'block', claim: '', advice: '审核返回格式异常，人工看一看' }], summary: '解析失败' };\n}\nconst issues = data.issues || [];\nconst blocks = issues.filter(i => i.level === 'block');\nreturn [{ json: {\n  passed: blocks.length === 0 && data.passed !== false,\n  score: data.score ?? 0,\n  summary: data.summary || '',\n  blocks: blocks.length,\n  issuesText: issues.map(i => `[${i.level}] ${i.claim || ''} -> ${i.advice || ''}`).join('\\n'),\n  title: $('解析稿件').first().json.title,\n  body: $('解析稿件').first().json.body,\n  sourceImage: $('参数').first().json.sourceImage\n} }];"
      },
      "id": "b7faf92b-6faf-41e8-b471-039bb8735149",
      "name": "解析审核",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1520,
