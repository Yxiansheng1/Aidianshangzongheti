        200,
        300
      ],
      "notes": "Webhook 调用时从这里读 body.source / body.imagePrompt / body.videoPrompt / body.size，没传就用默认值",
      "notesInFlow": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://127.0.0.1:8899/api/gen",
        "options": {
          "timeout": 120000
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ source: $json.source, prompt: $json.imagePrompt, size: parseInt($json.size) }) }}"
