              "type": "string"
            },
            {
              "id": "def8f655-b293-4d81-81ac-b25dc21fefbd",
              "name": "imagePrompt",
              "value": "={{ $json.body?.imagePrompt || '把商品放在浅色木纹桌面上，清晨柔和侧光，浅景深，背景轻微虚化，商品保持原样不变形' }}",
              "type": "string"
            },
            {
              "id": "da35d17f-480b-462f-b4ab-3e642a7a5195",
              "name": "videoPrompt",
              "value": "={{ $json.body?.videoPrompt || '镜头缓慢推进，光线缓缓移动，画面安静高级' }}",
              "type": "string"
            },
            {
              "id": "ab653b09-0044-4ccb-9a30-e29a708ba030",
              "name": "size",
              "value": "={{ $json.body?.size || 1024 }}",
              "type": "string"
